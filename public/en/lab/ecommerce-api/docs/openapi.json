  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "details"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      },
      "Variant": {
        "type": "object",
        "required": [
          "id",
          "label",
          "sku",
          "price_cents",
          "stock"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "price_cents": {
            "type": "integer",
            "minimum": 0
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "description",
          "image",
          "currency",
          "variants",
          "price_from_cents",
          "total_stock"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "accessories",
              "electronics",
              "workspace"
            ]
          },
          "description": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD"
            ]
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Variant"
            }
          },
          "price_from_cents": {
            "type": "integer"
          },
          "total_stock": {
            "type": "integer"
          }
        }
      },
      "CartItem": {
        "type": "object",
        "required": [
          "id",
          "product_id",
          "variant_id",
          "quantity",
          "product_name",
          "variant_label",
          "unit_price_cents",
          "subtotal_cents",
          "available_stock"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "product_id": {
            "type": "integer"
          },
          "variant_id": {
            "type": "integer"
          },
          "quantity": {
            "type": "integer"
          },
          "product_name": {
            "type": "string"
          },
          "variant_label": {
            "type": "string"
          },
          "unit_price_cents": {
            "type": "integer"
          },
          "subtotal_cents": {
            "type": "integer"
          },
          "available_stock": {
            "type": "integer"
          }
        }
      },
      "Cart": {
        "type": "object",
        "required": [
          "items",
          "quantity",
          "total_cents",
          "currency"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartItem"
            }
          },
          "quantity": {
            "type": "integer"
          },
          "total_cents": {
            "type": "integer"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD"
            ]
          }
        }
      },
      "Order": {
        "type": "object",
        "required": [
          "id",
          "reference",
          "status",
          "delivery_method",
          "currency",
          "total_cents",
          "items",
          "created_at",
          "demo_only"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "reference": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "demo_created"
            ]
          },
          "delivery_method": {
            "type": "string",
            "enum": [
              "demo_pickup",
              "demo_shipping"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD"
            ]
          },
          "total_cents": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartItem"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "demo_only": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        }
      },
      "Products": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "meta": {
            "type": "object",
            "required": [
              "page",
              "per_page",
              "total",
              "total_pages",
              "sort"
            ],
            "properties": {
              "page": {
                "type": "integer"
              },
              "per_page": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "total_pages": {
                "type": "integer"
              },
              "sort": {
                "type": "string"
              }
            }
          }
        }
      },
      "ProductResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Product"
          }
        }
      },
      "CartResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "cart"
            ],
            "properties": {
              "cart": {
                "$ref": "#/components/schemas/Cart"
              }
            }
          }
        }
      },
      "OrderResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "order"
            ],
            "properties": {
              "order": {
                "$ref": "#/components/schemas/Order"
              },
              "replayed": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "ResetResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "reset",
              "cart"
            ],
            "properties": {
              "reset": {
                "type": "boolean"
              },
              "cart": {
                "$ref": "#/components/schemas/Cart"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Read from any API response header, normally GET /cart. Same-origin session cookie is also required."
      }
    }
  }
